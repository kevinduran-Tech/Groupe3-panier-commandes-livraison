NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=groupe3_panier
DB_USER=postgres
DB_PASSWORD=postgres

# Module Catalogue & Stocks (Groupe 2) — voir groupe-2-catalogue-stocks/
# Tant que CATALOG_SERVICE_MOCK=true (ou l'URL vide), un catalogue simulé
# est utilisé (voir src/services/catalogueClient.js).
CATALOG_SERVICE_MOCK=true
CATALOG_SERVICE_URL=http://localhost:5002/api
CATALOG_ADMIN_KEY=changez-moi-en-production
